// ───────────────────────────────────────────────────────────────────
//  RE-ENTRY — Two Continuation Entries (Symmetric Long/Short)
// ───────────────────────────────────────────────────────────────────

GR = "Re-Entry (continuation)"
reEnabled  = input.bool(true,  "Enable re-entry alerts", group=GR)
reBufPct   = input.float(0.15, "34 EMA touch buffer (%)", step=0.05, group=GR)
reAwayBars = input.int(10,     "200 EMA fresh test: min bars away", minval=1, group=GR)
reSlBufPct = input.float(0.05, "200 EMA re-entry SL buffer (%)", step=0.05, group=GR)

bool touch200 = not na(ema200_15) and low <= ema200_15 and high >= ema200_15
var int barsAway200 = 100000
bool fresh200 = touch200 and barsAway200 >= reAwayBars
barsAway200 := touch200 ? 0 : barsAway200 + 1

bool re200Long  = reEnabled and fresh200 and close > ema200_15 and close > (high + low) / 2
bool re200Short = reEnabled and fresh200 and close < ema200_15 and close < (high + low) / 2

var int  rbDir    = 0
var bool re34Used = false

if isMegaBreakout
    rbDir    := megaUp ? 1 : -1
    re34Used := false
if (rbDir == 1 and emaBear) or (rbDir == -1 and emaBull)
    rbDir    := 0
    re34Used := false

float reBuf       = longEma * reBufPct / 100.0
bool touch34Long  = reEnabled and rbDir == 1  and not re34Used and low  <= longEma + reBuf
bool touch34Short = reEnabled and rbDir == -1 and not re34Used and high >= longEma - reBuf
bool re34Long     = touch34Long  and emaBull and close > longEma and close > cTop and close > (high + low) / 2 and not (e200_15_bear or e200_5_bear)
bool re34Short    = touch34Short and emaBear and close < longEma and close < cBot and close < (high + low) / 2 and not (e200_15_bull or e200_5_bull)
if touch34Long or touch34Short
    re34Used := true

bool  reLong  = re200Long or re34Long
bool  reShort = re200Short or re34Short
int   reType  = (re200Long or re200Short) ? 1 : (re34Long or re34Short) ? 2 : 0
float reSL = re200Long ? math.min(low, ema200_15) * (1 - reSlBufPct / 100) :
     re200Short ? math.max(high, ema200_15) * (1 + reSlBufPct / 100) :
     re34Long ? low : re34Short ? high : na

plotshape(reLong,  "Re-Entry Long",  shape.diamond, location.belowbar, color.new(#00e5ff, 0), size=size.small)
plotshape(reShort, "Re-Entry Short", shape.diamond, location.abovebar, color.new(#ff4081, 0), size=size.small)


// ───────────────────────────────────────────────────────────────────
//  GAP-DAY PULLBACK — 100+pt Gap (Standard Candle Close Default)
// ───────────────────────────────────────────────────────────────────

GG = "Gap-Day Pullback Entries"
gapEnabled  = input.bool(true,  "Enable gap-day pullback entries", group=GG)
gapMinPts   = input.float(100,  "Min gap size (pts)", minval=10, group=GG)
gapSlBufPct = input.float(0.10, "SL buffer beyond 34 EMA (%)", step=0.05, group=GG)
casGapFix   = input.bool(false, "CAS: measure gap vs 15:15 close (OFF = use standard candle close)", group=GG,
     tooltip="OFF by default: uses standard TradingView candle close (`dPivC`) without interrupting CAS.")

var float contCloseToday = na
var float contClosePrev  = na
bool isContBar = (hour(time, "Asia/Kolkata") * 100 + minute(time, "Asia/Kolkata")) < 1515

if session.isfirstbar_regular
    contClosePrev := contCloseToday

if isContBar
    contCloseToday := close

var bool gapDay    = false
var int  gapDir    = 0
var int  gapPlan   = 0
var bool gapT1Done = false
var bool gapT2Done = false

if session.isfirstbar_regular
    float refClose = (casGapFix and not na(contClosePrev)) ? contClosePrev : dPivC
    gapDay    := not na(refClose) and math.abs(open - refClose) >= gapMinPts
    gapDir    := gapDay ? (open < refClose ? -1 : 1) : 0
    gapPlan   := 0
    gapT1Done := false
    gapT2Done := false

bool gapAbsorb = gapEnabled and gapDay and not isMegaBreakout and
     ((gapDir == -1 and sellSignal) or (gapDir == 1 and buySignal))
if gapAbsorb and gapPlan == 0
    gapPlan := gapDir

float gapZone = gapPlan == 1 ? math.max(nz(ema13_5, close), nz(ema34_5, close)) :
     math.min(nz(ema13_5, close), nz(ema34_5, close))
bool gapT1Long  = gapEnabled and gapPlan == 1  and not gapT1Done and low  <= gapZone
bool gapT1Short = gapEnabled and gapPlan == -1 and not gapT1Done and high >= gapZone
if gapT1Long or gapT1Short
    gapT1Done := true

bool gapT2Long  = gapEnabled and gapPlan == 1  and gapT1Done and not gapT2Done and low  <= shortEma
bool gapT2Short = gapEnabled and gapPlan == -1 and gapT1Done and not gapT2Done and high >= shortEma
if gapT2Long or gapT2Short
    gapT2Done := true

float gapSL = gapPlan == 1 ? longEma * (1 - gapSlBufPct / 100) : longEma * (1 + gapSlBufPct / 100)

plotshape(gapT1Long or gapT2Long,   "Gap Pullback Long",  shape.square, location.belowbar, color.new(#ffd600, 0), size=size.small)
plotshape(gapT1Short or gapT2Short, "Gap Pullback Short", shape.square, location.abovebar, color.new(#ff9100, 0), size=size.small)


// ───────────────────────────────────────────────────────────────────
//  TREND-FLIP ENTRY (Decisive Close Through 200-EMA)
// ───────────────────────────────────────────────────────────────────

GT = "Trend-Flip entry (decisive 200-EMA break)"
tfEnabled   = input.bool(true,  "Enable trend-flip alerts", group=GT)
tfBreachPts = input.float(20,   "Decisive breach beyond 200 EMA (pts)", minval=1, group=GT)
tfSlBufPct  = input.float(0.05, "SL buffer beyond base level (%)", step=0.05, group=GT)

bool xTfLong  = ta.crossover(close,  ema200_15 + tfBreachPts)
bool xTfShort = ta.crossunder(close, ema200_15 - tfBreachPts)
bool tfLong   = tfEnabled and emaBull and not na(ema200_15) and xTfLong
bool tfShort  = tfEnabled and emaBear and not na(ema200_15) and xTfShort

float tfBaseLong = (longEma < close and stLine < close) ? math.max(longEma, stLine) :
     longEma < close ? longEma : stLine < close ? stLine : ema200_15
float tfBaseShort = (longEma > close and stLine > close) ? math.min(longEma, stLine) :
     longEma > close ? longEma : stLine > close ? stLine : ema200_15
float tfSL = tfLong ? tfBaseLong * (1 - tfSlBufPct / 100) :
     tfShort ? tfBaseShort * (1 + tfSlBufPct / 100) : na

plotshape(tfLong,  "Trend-Flip Long",  shape.triangleup,   location.belowbar, color.new(#76ff03, 0), size=size.small)
plotshape(tfShort, "Trend-Flip Short", shape.triangledown, location.abovebar, color.new(#ff6d00, 0), size=size.small)


// ───────────────────────────────────────────────────────────────────
//  5m EMA-CONFLUENCE ZONE
// ───────────────────────────────────────────────────────────────────

GCF = "5m EMA Confluence Zone"
cfShow     = input.bool(true,  "Mark 5m confluence tests", group=GCF)
cfMaxWidth = input.float(0.60, "Max cluster width (x ATR)", step=0.05, minval=0.05, group=GCF)
cfMinLines = input.int(2,      "Min lines in the cluster", minval=2, maxval=5, group=GCF)
cfDrawZone = input.bool(true,  "Shade the zone", group=GCF)

f_confluence(float maxW, int minL) =>
    float e34c  = ta.ema(close, 34)
    float e89h  = ta.ema(high, 89)
    float e89l  = ta.ema(low, 89)
    float e200c = ta.ema(close, 200)
    [stc, _dc]  = ta.supertrend(3.0, 5)
    float atrc  = ta.atr(14)
    float tol   = maxW * atrc
    arr = array.from(e34c, e89h, e89l, e200c, stc)
    array.sort(arr, order.ascending)
    int   bestN  = 1
    float bestLo = array.get(arr, 0)
    float bestHi = array.get(arr, 0)
    for i = 0 to array.size(arr) - 1
        int j = i
        while j + 1 < array.size(arr) and array.get(arr, j + 1) - array.get(arr, i) <= tol
            j := j + 1
        int cnt = j - i + 1
        if cnt > bestN or (cnt == bestN and array.get(arr, j) - array.get(arr, i) < bestHi - bestLo)
            bestN  := cnt
            bestLo := array.get(arr, i)
            bestHi := array.get(arr, j)
    bool  isConf = bestN >= minL
    bool  tested = isConf and low <= bestHi and high >= bestLo
    bool  sup    = tested and close > bestHi
    bool  rej    = tested and close < bestLo
    float strg   = tol > 0 ? math.max(0.0, math.min(1.0, 1.0 - (bestHi - bestLo) / tol)) : 0.0
    [bestN, bestLo, bestHi, sup, rej, strg]

[cfN, cfLo, cfHi, cfSup, cfRej, cfStr] = request.security(syminfo.tickerid, "5",
     f_confluence(cfMaxWidth, cfMinLines), lookahead=barmerge.lookahead_off)

plotshape(cfShow and cfSup, "5m Confluence SUPPORT", shape.cross, location.belowbar,
     color=color.new(#00e5ff, 0), size=size.tiny, text="C")
plotshape(cfShow and cfRej, "5m Confluence RESIST",  shape.cross, location.abovebar,
     color=color.new(#ff3d00, 0), size=size.tiny, text="C")

pLo = plot(cfShow and cfDrawZone and cfN >= cfMinLines ? cfLo : na, "Conf zone lo",
     color=color.new(#00e5ff, 55), display=display.pane)
pHi = plot(cfShow and cfDrawZone and cfN >= cfMinLines ? cfHi : na, "Conf zone hi",
     color=color.new(#00e5ff, 55), display=display.pane)
fill(pLo, pHi, color=color.new(#00e5ff, 88), title="Conf zone")



// ═══════════════════════════════════════════════════════════════════
//  HOISTED RISK & TARGET SPECIFICATION (Shared by Alerts & Ledger)
// ═══════════════════════════════════════════════════════════════════
GL = "Engine levels on chart (SL + T1/T2/T3)"
lvlShow = input.bool(true,  "Draw SL + T1/T2/T3 on entry alerts", group=GL)
lvlBars = input.int(40,     "Extend lines this many bars", minval=5, group=GL)
t1LPct  = input.float(0.50, "Long T1 %",  step=0.01, group=GL)
t2LPct  = input.float(0.92, "Long T2 %",  step=0.01, group=GL)
t3LPct  = input.float(1.79, "Long T3 %",  step=0.01, group=GL)
t1SPct  = input.float(0.50, "Short T1 %", step=0.01, group=GL)
t2SPct  = input.float(1.12, "Short T2 %", step=0.01, group=GL)
t3SPct  = input.float(2.12, "Short T3 %", step=0.01, group=GL)

useRFloor     = input.bool(true,  "Enforce Min 1.0R Target 1 & 2.0R Target 2 Floor (Fixes 125m/1D R:R)", group=GL,
     tooltip="On 125m and 1D, a fixed 0.50% T1 is only 0.2R against a 200pt stop (forcing Req BE% to 73-81%). When ON, T1 is at least 1.0x Initial Stop (1R) and T2 is at least 2.0x Initial Stop (2R), and initial Stop is capped at maxStopAtr x ATR.")
minT1R        = input.float(1.00, "Minimum T1 Risk-Reward Multiple (x 1R Stop)", minval=0.50, maxval=3.00, step=0.10, group=GL)
minT2R        = input.float(2.00, "Minimum T2 Risk-Reward Multiple (x 1R Stop)", minval=1.00, maxval=5.00, step=0.25, group=GL)
maxStopAtr    = input.float(1.80, "Max Initial Stop Distance Cap (x Chart ATR14)", minval=0.80, maxval=4.00, step=0.10, group=GL,
     tooltip="Caps abnormally wide stops so a distant swing pivot never creates a 300+ pt stop loss.")

f_calcRiskAndTargets(bool _isLong, float _rawSL) =>
    bool  hasSL     = not na(_rawSL) and _rawSL > 0.0
    float safeAtr   = nz(atr14, close * 0.006)
    bool  validSide = hasSL and (_isLong ? _rawSL < close : _rawSL > close)
    float rawDist   = validSide ? (_isLong ? (close - _rawSL) : (_rawSL - close)) : (1.2 * safeAtr)
    float minStop   = math.max(syminfo.mintick * 20.0, 0.35 * safeAtr)
    float maxStop   = math.max(minStop, maxStopAtr * safeAtr)
    float riskPts   = hasSL ? (useRFloor ? math.min(maxStop, math.max(minStop, rawDist)) : math.max(minStop, rawDist)) : 0.0
    float effSL     = hasSL ? (_isLong ? (close - riskPts) : (close + riskPts)) : 0.0
    float baseT1  = close * ((_isLong ? t1LPct : t1SPct) / 100.0)
    float baseT2  = close * ((_isLong ? t2LPct : t2SPct) / 100.0)
    float t1Pts   = hasSL ? (useRFloor ? math.max(baseT1, minT1R * riskPts) : baseT1) : 0.0
    float t2Pts   = hasSL ? (useRFloor ? math.max(baseT2, minT2R * riskPts) : baseT2) : 0.0
    float t1Price = hasSL ? (_isLong ? (close + t1Pts) : (close - t1Pts)) : 0.0
    float t2Price = hasSL ? (_isLong ? (close + t2Pts) : (close - t2Pts)) : 0.0
    [riskPts, t1Pts, t2Pts, effSL, t1Price, t2Price]

// ═══════════════════════════════════════════════════════════════════
//  UNIFIED JSON ALERT (All Intraday & 125m/1D Swing Grades)
// ═══════════════════════════════════════════════════════════════════

f_json(string _grade, string _dir, float _sl, int _sig, int _reType, string _swingKind, bool _isArmed) =>
    bool  _isLong = _dir == "LONG"
    bool  _hasSL  = not na(_sl) and _sl > 0.0
    [rPts, t1P, t2P, effSL, t1Prc, t2Prc] = f_calcRiskAndTargets(_isLong, _sl)
    int   sc  = _isLong ? bullScore : bearScore
    bool  blk = _grade == "MEGA" ? megaBlocked : ema200_blocked
    string slStr       = _hasSL ? str.tostring(_sl, "0.00") : "null"
    string cappedSlStr = _hasSL ? str.tostring(effSL, "0.00") : "null"
    string rDistStr    = _hasSL ? str.tostring(rPts, "0.00") : "null"
    string t1DistStr   = _hasSL ? str.tostring(t1P, "0.00") : "null"
    string t2DistStr   = _hasSL ? str.tostring(t2P, "0.00") : "null"
    string t1Str       = _hasSL ? str.tostring(t1Prc, "0.00") : "null"
    string t2Str       = _hasSL ? str.tostring(t2Prc, "0.00") : "null"
    '{"secret":"' + webhookSecret + '","v":"4.3.0","sym":"' + syminfo.ticker + '","tf":"' + timeframe.period + '","swingTf":"' + evalHtfLabel + '","dir":"' + _dir + '","grade":"' + _grade +
     '","score":' + str.tostring(sc) +
     ',"sig":'    + str.tostring(_sig) +
     ',"reType":' + str.tostring(_reType) +
     ',"sl":'     + slStr +
     ',"cappedSl":' + cappedSlStr +
     ',"rDist":'  + rDistStr +
     ',"t1Dist":' + t1DistStr +
     ',"t2Dist":' + t2DistStr +
     ',"t1":'     + t1Str +
     ',"t2":'     + t2Str +
     ',"close":'  + str.tostring(close, "0.00") +
     ',"swingKind":"' + _swingKind +
     '","isArmed":'   + (_isArmed ? "true" : "false") +
     ',"rHigh":'  + str.tostring(nz(prevRHigh, 0), "#") +
     ',"rLow":'   + str.tostring(nz(prevRLow, 0),  "#") +
     ',"st":'     + str.tostring(stLine, "#") +
     ',"ema34":'  + str.tostring(longEma, "#") +
     ',"ema200_5":'  + str.tostring(nz(ema200_5, 0), "#") +
     ',"ema200_15":' + str.tostring(nz(ema200_15, 0), "#") +
     ',"cloudTop":'  + str.tostring(nz(cTop, 0), "#") +
     ',"cloudBot":'  + str.tostring(nz(cBot, 0), "#") +
     ',"blocked":'   + (blk ? "true" : "false") +
     ',"swingState":'+ str.tostring(swingState) +
     ',"swingConf":' + str.tostring(activeSwingSc) +
     ',"futQuad":"'  + futQuadrant +
     '","fusion":"'  + fusionScenario +
     '","basis":'    + str.tostring(rawBasis, "0.00") +
     ',"adjBasis":'  + str.tostring(adjustedBasisSpread, "0.00") +
     ',"futPricePct":' + str.tostring(futPriceChgPct, "0.00") +
     ',"futOiPct":'  + str.tostring(effOiChgPct, "0.00") +
     ',"futOiSrc":"' + futOiSource +
     '","dte":'      + str.tostring(dteEff) +
     ',"actRoof":'   + str.tostring(actRoof, "#") +
     ',"actFloor":'  + str.tostring(actFloor, "#") +
     ',"comp":'      + (compWindowActive ? "true" : "false") +
     ',"vboUp":'     + str.tostring(nz(vboUp, 0), "#") +
     ',"vboDn":'     + str.tostring(nz(vboDn, 0), "#") +
     ',"vboBreak":"' + (vboBreakUp ? "UP" : vboBreakDn ? "DOWN" : "NONE") +
     '","confTest":"'+ (cfSup ? "SUPPORT" : cfRej ? "RESIST" : "NONE") +
     '","confN":'    + str.tostring(nz(cfN, 0)) +
     ',"confStr":'   + str.tostring(nz(cfStr, 0), "0.00") +
     ',"confLo":'    + str.tostring(nz(cfLo, 0), "#") +
     ',"confHi":'    + str.tostring(nz(cfHi, 0), "#") +
     ',"t":"' + str.format_time(time_close, "yyyy-MM-dd'T'HH:mm", "Asia/Kolkata") + '"}'

string swKindLong  = activeSwingTag == 7 ? "CONTINUATION" : "REVERSAL"
string swKindShort = activeSwingTag == 7 ? "CONTINUATION" : "REVERSAL"

if isMegaBreakout
    alert(f_json("MEGA", megaUp ? "LONG" : "SHORT", 0.0, megaSigNum, 0, "INTRADAY", false), alert.freq_once_per_bar_close)
else if newSig and not gapAbsorb
    alert(f_json(isBreakoutWatch ? "WATCH" : "SIGNAL", buySignal ? "LONG" : "SHORT", 0.0, sigCount, 0, "INTRADAY", false), alert.freq_once_per_bar_close)
else if vboBreakUp or vboBreakDn
    alert(f_json("VBO_BREAK", vboBreakUp ? "LONG" : "SHORT", 0.0, sigCount, 0, "INTRADAY", false), alert.freq_once_per_bar_close)

if reLong or reShort
    alert(f_json("RE_ENTRY", reLong ? "LONG" : "SHORT", reSL, sigCount, reType, "INTRADAY", false), alert.freq_once_per_bar_close)
if tfLong or tfShort
    alert(f_json("TREND_FLIP", tfLong ? "LONG" : "SHORT", tfSL, sigCount, 0, "INTRADAY", false), alert.freq_once_per_bar_close)
if gapT1Long or gapT1Short
    alert(f_json("GAP_PULLBACK", gapT1Long ? "LONG" : "SHORT", gapSL, sigCount, 0, "INTRADAY", false), alert.freq_once_per_bar)
if gapT2Long or gapT2Short
    alert(f_json("GAP_ADD", gapT2Long ? "LONG" : "SHORT", gapSL, sigCount, 0, "INTRADAY", false), alert.freq_once_per_bar)

// Swing & Smart Money Trap Alerts
float swBotSL = nz(activeSwingLvl, low)  - (swingSlAtr * nz(activeSwingAtr, atr14))
float swTopSL = nz(activeSwingLvl, high) + (swingSlAtr * nz(activeSwingAtr, atr14))
if confirmBottom
    alert(f_json("SWING_BOTTOM", "LONG", swBotSL, sigCount, activeSwingTag, swKindLong, isBottomArmed), alert.freq_once_per_bar_close)
if confirmTop
    alert(f_json("SWING_TOP", "SHORT", swTopSL, sigCount, activeSwingTag, swKindShort, isTopArmed), alert.freq_once_per_bar_close)
if bearTrapSig
    alert(f_json("BEAR_TRAP_BUY", "LONG", bearTrapSL, sigCount, 8, "TRAP", isBottomArmed), alert.freq_once_per_bar_close)
if bullTrapSig
    alert(f_json("BULL_TRAP_SELL", "SHORT", bullTrapSL, sigCount, 8, "TRAP", isTopArmed), alert.freq_once_per_bar_close)
if whSendSynergy and synergyBullTrigger
    alert(f_json("SYNERGY_BULL", "LONG", synBullSL, sigCount, 9, "SYNERGY", isBottomArmed), alert.freq_once_per_bar_close)
if whSendSynergy and synergyBearTrigger
    alert(f_json("SYNERGY_BEAR", "SHORT", synBearSL, sigCount, 9, "SYNERGY", isTopArmed), alert.freq_once_per_bar_close)


// ═══════════════════════════════════════════════════════════════════
//  ENGINE LEVELS ON CHART (SL + T1/T2/T3 — Including SWING & TREND_FLIP)
// ═══════════════════════════════════════════════════════════════════



bool lvlLong = (isMegaBreakout and megaUp) or (newSig and not gapAbsorb and buySignal) or
     vboBreakUp or reLong or tfLong or gapT1Long or gapT2Long or confirmBottom or bearTrapSig
bool lvlShort = (isMegaBreakout and not megaUp) or (newSig and not gapAbsorb and sellSignal) or
     vboBreakDn or reShort or tfShort or gapT1Short or gapT2Short or confirmTop or bullTrapSig
float lvlSL = confirmBottom ? swBotSL :
     confirmTop ? swTopSL :
     bearTrapSig ? bearTrapSL :
     bullTrapSig ? bullTrapSL :
     (reLong or reShort) ? reSL :
     (tfLong or tfShort) ? tfSL :
     (gapT1Long or gapT1Short or gapT2Long or gapT2Short) ? gapSL : stLine

var line  lnSL = na
var line  lnT1 = na
var line  lnT2 = na
var line  lnT3 = na
var label lbSL = na
var label lbT1 = na
var label lbT2 = na
var label lbT3 = na

f_lvl(float _y, color _c) =>
    line.new(bar_index, _y, bar_index + lvlBars, _y, color=_c, width=1, style=line.style_dashed)
f_tag(float _y, string _s, color _c) =>
    label.new(bar_index + lvlBars, _y, _s, style=label.style_label_left,
     color=color.new(_c, 85), textcolor=_c, size=size.small)

if lvlShow and (lvlLong or lvlShort)
    line.delete(lnSL)
    line.delete(lnT1)
    line.delete(lnT2)
    line.delete(lnT3)
    label.delete(lbSL)
    label.delete(lbT1)
    label.delete(lbT2)
    label.delete(lbT3)
    float lt1 = lvlLong ? close * (1 + t1LPct / 100) : close * (1 - t1SPct / 100)
    float lt2 = lvlLong ? close * (1 + t2LPct / 100) : close * (1 - t2SPct / 100)
    float lt3 = lvlLong ? close * (1 + t3LPct / 100) : close * (1 - t3SPct / 100)
    lnSL := f_lvl(lvlSL, color.new(#ff1744, 0))
    lnT1 := f_lvl(lt1,   color.new(#00c853, 0))
    lnT2 := f_lvl(lt2,   color.new(#00c853, 30))
    lnT3 := f_lvl(lt3,   color.new(#00c853, 50))
    lbSL := f_tag(lvlSL, "SL " + str.tostring(lvlSL, "#"), #ff1744)
    lbT1 := f_tag(lt1,   "T1 " + str.tostring(lt1, "#"),   #00c853)
    lbT2 := f_tag(lt2,   "T2 " + str.tostring(lt2, "#"),   #00c853)
    lbT3 := f_tag(lt3,   "T3 " + str.tostring(lt3, "#"),   #00c853)


// ═══════════════════════════════════════════════════════════════════
//  ⑮ WALK-FORWARD STATISTICAL LEDGER (Next-Open Fill & Next-Open Time-Stop,
//     Same-Bar Post-T1 BE Check, True Wilson 95% CI, & Forward OOS Gate)
// ═══════════════════════════════════════════════════════════════════

GBT_VER = "⑮ Walk-Forward Verification Ledger & Go/No-Go Audit"
showVerifTbl  = input.bool(true,  "Show Walk-Forward Verification Table (Bottom-Right)", group=GBT_VER)
verifWindow   = input.string("Modern Real-OI Era (2021-01-01 to 2026-11-08)", "Evaluation Window",
     options=[
          "Modern Real-OI Era (2021-01-01 to 2026-11-08)",
          "Full Chart History (In-Sample)",
          "Historical Pre-2024 (2019-01-01 to 2023-12-31)",
          "Historical Post-2024 (2024-01-01 to 2026-11-08 — Tuned In-Sample)",
          "Forward Paper/Live OOS Only (From 2026-11-09 Onward)"
     ], group=GBT_VER,
     tooltip="Because rules were refined after viewing 2020-2026 regimes and Aug-Nov 2026 dates, all history through Nov 8, 2026 is In-Sample. True Out-of-Sample validation requires Forward Paper Trading from Nov 9, 2026 onward.")
verifMode     = input.string("Traps Only (Bull/Bear Trap)", "Signals to Audit in Ledger",
     options=["Traps Only (Bull/Bear Trap)", "Structural Swings Only (125m/1D)", "Traps + Structural Swings"], group=GBT_VER)
gateSwingsFlw = input.bool(false, "Also Require Orderflow Gate on 125m/1D Structural Swings", group=GBT_VER,
     tooltip="Toggle ON vs OFF on 125m/1D charts to test whether requiring bullTrapFlow/bearTrapFlow improves or starves 125m/1D structural swing signals.")
costPtsInput  = input.float(4.0,  "Unified Round-Trip Cost (Nifty Index Points)", minval=0.0, maxval=25.0, step=0.5, group=GBT_VER,
     tooltip="Matches the Strategy Tester's 40-tick (2.0pt/side = 4.0pt round-trip) slippage setting exactly.")
scaleOutPct   = input.float(0.60, "T1 Scale-Out Fraction (0.60 = 3 of 5 Lots at T1, 2 Lots Runner)", minval=0.20, maxval=0.80, step=0.20, group=GBT_VER)
// (useRFloor, minT1R, minT2R, maxStopAtr hoisted above for alert parity)
maxHold15m    = input.int(20,     "Max Hold Bars on <=15m (Time-Stop, 20 = 5 Hrs)", minval=4, maxval=100, group=GBT_VER)
maxHold125m   = input.int(15,     "Max Hold Bars on 125m/Hourly (Time-Stop, 15 = 5 Days)", minval=4, maxval=100, group=GBT_VER)
maxHoldDaily  = input.int(12,     "Max Hold Bars on Daily (Time-Stop, 12 = 2.5 Weeks)", minval=3, maxval=60, group=GBT_VER)

int effMaxHold = isDailyChart ? maxHoldDaily : (tfMins >= 60 ? maxHold125m : maxHold15m)

// Evaluation Window Date Gate (IST timestamps)
int ts2019   = timestamp("Asia/Kolkata", 2019, 1, 1, 0, 0)
int ts2021   = timestamp("Asia/Kolkata", 2021, 1, 1, 0, 0)
int ts2024   = timestamp("Asia/Kolkata", 2024, 1, 1, 0, 0)
int tsFwdOos = timestamp("Asia/Kolkata", 2026, 11, 9, 0, 0)

bool isFwdOosMode  = verifWindow == "Forward Paper/Live OOS Only (From 2026-11-09 Onward)"
bool inAuditWindow = verifWindow == "Full Chart History (In-Sample)" ? true :
     verifWindow == "Modern Real-OI Era (2021-01-01 to 2026-11-08)" ? (time >= ts2021 and time < tsFwdOos) :
     verifWindow == "Historical Pre-2024 (2019-01-01 to 2023-12-31)" ? (time >= ts2019 and time < ts2024) :
     verifWindow == "Historical Post-2024 (2024-01-01 to 2026-11-08 — Tuned In-Sample)" ? (time >= ts2024 and time < tsFwdOos) :
     (time >= tsFwdOos)

// Track first and last bar timestamps in active audit window to compute trades/year
var int firstAuditTime = na
var int lastAuditTime  = na
if inAuditWindow
    totalBarsCount += 1
    if hasRealNearOi
        realOiBarsCount += 1
    if na(firstAuditTime)
        firstAuditTime := time
    lastAuditTime := time

// Pending next-open order state (queued on signal bar close, filled at next bar open!)
var int   pendDir        = 0
var float pendRiskPts    = na
var float pendT1Pts      = na
var float pendT2Pts      = na

// Active open trade state
var int   trDir          = 0
var float trEntry        = na
var float trInitRisk     = na
var float trInitSL       = na
var float trCurrSL       = na
var float trT1           = na
var float trT2           = na
var bool  trHitT1        = false
var float trLeg1Pnl      = 0.0
var int   trBarsHeld     = 0
var bool  trTimeStopPend = false

// Completed trade statistics (updated strictly when a trade closes!)
var int   statN          = 0
var int   statT1Hits     = 0
var int   statT2Hits     = 0
var int   statFullSlHits = 0
var int   statBeStops    = 0
var int   statTimeExits  = 0
var int   statNetWins    = 0
var int   statNetLosses  = 0
var float statGrossWin   = 0.0
var float statGrossLoss  = 0.0
var float statCumPnl     = 0.0
var float statPeakPnl    = 0.0
var float statMaxDd      = 0.0
var float statSumInitR   = 0.0
var float statSumT1Pts   = 0.0
var float statSumRMult   = 0.0

// 1. Fill pending order at the OPEN of the current bar (matching strategy() next-open fill!)
if pendDir != 0 and trDir == 0
    trDir          := pendDir
    trEntry        := open
    trInitRisk     := math.max(syminfo.mintick * 10.0, pendRiskPts)
    trInitSL       := pendDir == 1 ? (open - trInitRisk) : (open + trInitRisk)
    trCurrSL       := trInitSL
    trT1           := pendDir == 1 ? (open + pendT1Pts)  : (open - pendT1Pts)
    trT2           := pendDir == 1 ? (open + pendT2Pts)  : (open - pendT2Pts)
    trHitT1        := false
    trLeg1Pnl      := 0.0
    trBarsHeld     := 0
    trTimeStopPend := false
    pendDir        := 0

// 2. Evaluate active trade on current bar
if trDir != 0
    bool  closedNow = false
    float netPnl    = 0.0

    // 2a. If Time-Stop triggered at prior bar close, exit at THIS bar's OPEN (matching strategy.close() next-open fill!)
    if trTimeStopPend
        float remFrac = trHitT1 ? (1.0 - scaleOutPct) : 1.0
        float leg2Pnl = trDir == 1 ? (open - trEntry) * remFrac : (trEntry - open) * remFrac
        netPnl         := trLeg1Pnl + leg2Pnl - costPtsInput
        closedNow      := true
        statTimeExits  += 1
        trTimeStopPend := false
    else
        trBarsHeld += 1
        bool wasHitT1 = trHitT1

        if trDir == 1
            // Conservative check: Stop Loss checked first (with gap-down fill at `math.min(open, trCurrSL)`)
            if low <= trCurrSL
                float slFill  = math.min(open, trCurrSL)
                float leg2Pnl = trHitT1 ? (slFill - trEntry) * (1.0 - scaleOutPct) : (slFill - trEntry)
                netPnl        := trLeg1Pnl + leg2Pnl - costPtsInput
                closedNow     := true
                if trHitT1
                    statBeStops += 1
                else
                    statFullSlHits += 1
            else
                // Check T1 hit (with gap-up fill at `math.max(open, trT1)`)
                if not trHitT1 and high >= trT1
                    float t1Fill = math.max(open, trT1)
                    trHitT1   := true
                    trLeg1Pnl := (t1Fill - trEntry) * scaleOutPct
                    trCurrSL  := trEntry
                // Check T2 hit (with gap-up fill at `math.max(open, trT2)`)
                if trHitT1 and high >= trT2
                    float t2Fill  = math.max(open, trT2)
                    float leg2Pnl = (t2Fill - trEntry) * (1.0 - scaleOutPct)
                    netPnl        := trLeg1Pnl + leg2Pnl - costPtsInput
                    closedNow     := true
                    statT2Hits    += 1
                // Conservative same-bar post-T1 reversal check: if T1 was first touched on this bar AND price reversed back below entry by bar close, stop out runner at BE!
                else if not wasHitT1 and trHitT1 and low <= trEntry and close <= trEntry
                    netPnl      := trLeg1Pnl - costPtsInput
                    closedNow   := true
                    statBeStops += 1
                // Arm next-open Time-Stop if maxHoldBars reached at bar close
                else if trBarsHeld >= effMaxHold or not inAuditWindow
                    trTimeStopPend := true

        else if trDir == -1
            // Conservative check: Stop Loss checked first (with gap-up fill at `math.max(open, trCurrSL)`)
            if high >= trCurrSL
                float slFill  = math.max(open, trCurrSL)
                float leg2Pnl = trHitT1 ? (trEntry - slFill) * (1.0 - scaleOutPct) : (trEntry - slFill)
                netPnl        := trLeg1Pnl + leg2Pnl - costPtsInput
                closedNow     := true
                if trHitT1
                    statBeStops += 1
                else
                    statFullSlHits += 1
            else
                if not trHitT1 and low <= trT1
                    float t1Fill = math.min(open, trT1)
                    trHitT1   := true
                    trLeg1Pnl := (trEntry - t1Fill) * scaleOutPct
                    trCurrSL  := trEntry
                if trHitT1 and low <= trT2
                    float t2Fill  = math.min(open, trT2)
                    float leg2Pnl = (trEntry - t2Fill) * (1.0 - scaleOutPct)
                    netPnl        := trLeg1Pnl + leg2Pnl - costPtsInput
                    closedNow     := true
                    statT2Hits    += 1
                else if not wasHitT1 and trHitT1 and high >= trEntry and close >= trEntry
                    netPnl      := trLeg1Pnl - costPtsInput
                    closedNow   := true
                    statBeStops += 1
                else if trBarsHeld >= effMaxHold or not inAuditWindow
                    trTimeStopPend := true

        if not wasHitT1 and trHitT1 and whSendExits
            alert(f_json("TARGET_1_HIT", trDir == 1 ? "LONG" : "SHORT", trEntry, 0, 0, "EXIT", false), alert.freq_once_per_bar)

    // Record completed trade metrics (with nz() guard so early-bar na never poisons statSumInitR with NaN!)
    if closedNow
        if whSendExits
            string exitReasonStr = (trDir == 1 ? (high >= trT2) : (low <= trT2)) ? "TARGET_2_HIT" : (trHitT1 ? "BREAKEVEN_STOP" : (trTimeStopPend ? "TIME_STOP_EXIT" : "STOP_LOSS_HIT"))
            alert(f_json(exitReasonStr, trDir == 1 ? "LONG" : "SHORT", close, 0, 0, "EXIT", false), alert.freq_once_per_bar)
        float safeInitR = math.max(1.0, nz(trInitRisk, nz(atr14, close * 0.005)))
        float safeT1Dist = math.max(1.0, nz(math.abs(trT1 - trEntry), close * 0.005))
        statN        += 1
        if trHitT1
            statT1Hits += 1
        statSumInitR += safeInitR
        statSumT1Pts += safeT1Dist
        statSumRMult += nz(netPnl / safeInitR, 0.0)
        if netPnl > 0
            statNetWins  += 1
            statGrossWin += netPnl
        else
            statNetLosses += 1
            statGrossLoss += math.abs(netPnl)
        statCumPnl  += netPnl
        statPeakPnl := math.max(statPeakPnl, statCumPnl)
        statMaxDd   := math.max(statMaxDd, statPeakPnl - statCumPnl)
        trDir       := 0

// 3. Queue new order at confirmed bar close if flat and inside walk-forward window
bool includeTraps  = verifMode == "Traps Only (Bull/Bear Trap)" or verifMode == "Traps + Structural Swings"
bool includeSwings = verifMode == "Structural Swings Only (125m/1D)" or verifMode == "Traps + Structural Swings"

bool swLongGated   = confirmBottom and (not gateSwingsFlw or bearTrapFlow)
bool swShortGated  = confirmTop    and (not gateSwingsFlw or bullTrapFlow)

bool auditLongSig  = inAuditWindow and ((includeTraps and bearTrapSig) or (includeSwings and swLongGated))
bool auditShortSig = inAuditWindow and ((includeTraps and bullTrapSig) or (includeSwings and swShortGated))

// (f_calcRiskAndTargets hoisted above for alert parity)

if trDir == 0 and pendDir == 0 and barstate.isconfirmed and not na(atr14)
    if auditLongSig
        float rawSL = (includeSwings and swLongGated) ? swBotSL : bearTrapSL
        [rPts, t1P, t2P, effSL_a, t1Price_a, t2Price_a] = f_calcRiskAndTargets(true, rawSL)
        pendDir     := 1
        pendRiskPts := rPts
        pendT1Pts   := t1P
        pendT2Pts   := t2P
    else if auditShortSig
        float rawSL = (includeSwings and swShortGated) ? swTopSL : bullTrapSL
        [rPts, t1P, t2P, effSL_a, t1Price_a, t2Price_a] = f_calcRiskAndTargets(false, rawSL)
        pendDir     := -1
        pendRiskPts := rPts
        pendT1Pts   := t1P
        pendT2Pts   := t2P

// Helper: True Wilson Score 95% Confidence Interval (z = 1.96, z^2 = 3.8416)
f_wilson95(int _wins, int _n) =>
    if _n <= 0
        [0.0, 0.0, 0.0]
    else
        float nf     = float(_n)
        float pHat   = float(_wins) / nf
        float z2     = 3.8416
        float denom  = 1.0 + z2 / nf
        float center = (pHat + z2 / (2.0 * nf)) / denom
        float half   = (1.96 * math.sqrt(math.max(0.0, (pHat * (1.0 - pHat) / nf) + (z2 / (4.0 * nf * nf))))) / denom
        float loPct  = math.max(0.0, (center - half) * 100.0)
        float hiPct  = math.min(100.0, (center + half) * 100.0)
        [pHat * 100.0, loPct, hiPct]

// 4. Render 11-Row Walk-Forward Statistical Audit Table (Bottom-Right)
var table verifTbl = table.new(position.bottom_right, 2, 11, border_width=1, border_color=color.new(#37474f, 0))
if barstate.islast and showVerifTbl
    [pT1, t1Lo, t1Hi]          = f_wilson95(statT1Hits, statN)
    [netWinPct, winLo, winHi]  = f_wilson95(statNetWins, statN)
    float pT2                  = statN > 0 ? (float(statT2Hits) / float(statN)) * 100.0 : 0.0
    float pf                   = statGrossLoss > 0 ? statGrossWin / statGrossLoss : (statGrossWin > 0 ? 99.9 : 0.0)
    float expectPts            = statN > 0 ? statCumPnl / float(statN) : 0.0
    float avgWinPts            = statNetWins > 0 ? statGrossWin / float(statNetWins) : 0.0
    float avgLossPts           = statNetLosses > 0 ? statGrossLoss / float(statNetLosses) : 0.0
    float reqBeWinPct          = (avgWinPts + avgLossPts) > 0 ? (avgLossPts / (avgWinPts + avgLossPts)) * 100.0 : 50.0
    float avgInitR             = statN > 0 ? statSumInitR / float(statN) : 0.0
    float avgT1Dist            = statN > 0 ? statSumT1Pts / float(statN) : 0.0
    float avgRMult             = statN > 0 ? statSumRMult / float(statN) : 0.0
    float yrsSpan              = (not na(firstAuditTime) and not na(lastAuditTime) and lastAuditTime > firstAuditTime) ? math.max(0.1, float(lastAuditTime - firstAuditTime) / 31557600000.0) : 1.0
    float tradesPerYr          = float(statN) / yrsSpan
    float oiCovPct             = totalBarsCount > 0 ? (float(realOiBarsCount) / float(totalBarsCount)) * 100.0 : 0.0

    // Reviewer Go/No-Go Criteria:
    bool passMinN   = statN >= 30
    bool passFullN  = statN >= 100
    bool passPf     = pf >= 1.30
    bool passExp    = expectPts >= (2.0 * costPtsInput)
    bool passWilson = winLo > reqBeWinPct
    bool statsPass  = passMinN and passPf and passExp and passWilson

    string winShort = verifWindow == "Modern Real-OI Era (2021-01-01 to 2026-11-08)" ? "OI-ERA 21-26" : verifWindow == "Full Chart History (In-Sample)" ? "HIST-ALL" :
         verifWindow == "Historical Pre-2024 (2019-01-01 to 2023-12-31)" ? "HIST 19-23" :
         verifWindow == "Historical Post-2024 (2024-01-01 to 2026-11-08 — Tuned In-Sample)" ? "HIST 24-26" : "FWD OOS"

    table.cell(verifTbl, 0, 0, "📊 AUDIT [" + winShort + " · " + timeframe.period + "]", bgcolor=color.new(#1c252c, 0), text_color=color.white, text_size=size.tiny, text_halign=text.align_left)
    table.cell(verifTbl, 1, 0, "n=" + str.tostring(statN) + " (" + str.tostring(tradesPerYr, "0.0") + "/yr | TStop:" + str.tostring(statTimeExits) + ")", bgcolor=passFullN ? color.new(#1b5e20, 0) : passMinN ? color.new(#e65100, 0) : color.new(#b71c1c, 0), text_color=color.white, text_size=size.tiny)

    table.cell(verifTbl, 0, 1, "Real _OI Coverage / Chart", bgcolor=color.new(#10171d, 0), text_color=color.new(#b0bec5, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(verifTbl, 1, 1, str.tostring(oiCovPct, "0.0") + "% Real _OI (" + str.tostring(realOiBarsCount) + "/" + str.tostring(totalBarsCount) + ")", bgcolor=color.new(#10171d, 0), text_color=oiCovPct >= 50.0 ? color.new(#69f0ae, 0) : color.new(#ffd740, 0), text_size=size.tiny)

    table.cell(verifTbl, 0, 2, "P(T1 Hit) [Wilson 95%]", bgcolor=color.new(#10171d, 0), text_color=color.new(#b0bec5, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(verifTbl, 1, 2, str.tostring(pT1, "0.0") + "% [" + str.tostring(t1Lo, "0") + "–" + str.tostring(t1Hi, "0") + "%]", bgcolor=color.new(#10171d, 0), text_color=color.white, text_size=size.tiny)

    table.cell(verifTbl, 0, 3, "Net Win% [Wilson 95%]", bgcolor=color.new(#10171d, 0), text_color=color.new(#b0bec5, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(verifTbl, 1, 3, str.tostring(netWinPct, "0.0") + "% [" + str.tostring(winLo, "0") + "–" + str.tostring(winHi, "0") + "%]", bgcolor=color.new(#10171d, 0), text_color=passWilson ? color.new(#69f0ae, 0) : color.new(#ffd740, 0), text_size=size.tiny)

    table.cell(verifTbl, 0, 4, "P(T2) / BE-Stop / Full-SL", bgcolor=color.new(#10171d, 0), text_color=color.new(#b0bec5, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(verifTbl, 1, 4, str.tostring(pT2, "0.0") + "% / " + str.tostring(statBeStops) + " BE / " + str.tostring(statFullSlHits) + " SL", bgcolor=color.new(#10171d, 0), text_color=color.white, text_size=size.tiny)

    table.cell(verifTbl, 0, 5, "Avg Win / Avg Loss / Req BE%", bgcolor=color.new(#10171d, 0), text_color=color.new(#b0bec5, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(verifTbl, 1, 5, "+" + str.tostring(avgWinPts, "0") + " / -" + str.tostring(avgLossPts, "0") + " (Req " + str.tostring(reqBeWinPct, "0") + "%)", bgcolor=color.new(#10171d, 0), text_color=color.white, text_size=size.tiny)

    table.cell(verifTbl, 0, 6, "Avg 1R Stop / Avg T1 / Avg R", bgcolor=color.new(#10171d, 0), text_color=color.new(#b0bec5, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(verifTbl, 1, 6, str.tostring(avgInitR, "0") + "pt / " + str.tostring(avgT1Dist, "0") + "pt / " + (avgRMult >= 0 ? "+" : "") + str.tostring(avgRMult, "0.00") + "R", bgcolor=color.new(#10171d, 0), text_color=avgRMult > 0 ? color.new(#69f0ae, 0) : color.new(#ff8a80, 0), text_size=size.tiny)

    table.cell(verifTbl, 0, 7, "Net Profit Factor (Cost=" + str.tostring(costPtsInput, "0.0") + ")", bgcolor=color.new(#10171d, 0), text_color=color.new(#b0bec5, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(verifTbl, 1, 7, str.tostring(pf, "0.00") + (passPf ? " (≥1.3)" : " (<1.3)"), bgcolor=color.new(#10171d, 0), text_color=passPf ? color.new(#69f0ae, 0) : color.new(#ff8a80, 0), text_size=size.tiny)

    table.cell(verifTbl, 0, 8, "Net Expectancy / Trade", bgcolor=color.new(#10171d, 0), text_color=color.new(#b0bec5, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(verifTbl, 1, 8, (expectPts >= 0 ? "+" : "") + str.tostring(expectPts, "0.0") + " pts (2xCost=" + str.tostring(2.0 * costPtsInput, "0") + ")", bgcolor=color.new(#10171d, 0), text_color=passExp ? color.new(#69f0ae, 0) : color.new(#ff8a80, 0), text_size=size.tiny)

    table.cell(verifTbl, 0, 9, "Cum Net PnL / Max DD", bgcolor=color.new(#10171d, 0), text_color=color.new(#b0bec5, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(verifTbl, 1, 9, (statCumPnl >= 0 ? "+" : "") + str.tostring(math.round(statCumPnl)) + " / -" + str.tostring(math.round(statMaxDd)) + " pts", bgcolor=color.new(#10171d, 0), text_color=color.white, text_size=size.tiny)

    string goText = (isFwdOosMode and statsPass) ? "✅ LIVE GO (FWD OOS VALIDATED)" :
         (not isFwdOosMode and statsPass and passFullN) ? "🟡 HIST PASS (PAPER 30+ FWD FIRST)" :
         (statsPass or (passMinN and pf >= 1.15 and expectPts > costPtsInput)) ? "⚠️ MARGINAL (PAPER ONLY)" :
         "🚫 NO-GO (DO NOT TRADE LIVE)"
    color  goBg   = (isFwdOosMode and statsPass) ? color.new(#1b5e20, 0) :
         (not isFwdOosMode and statsPass) ? color.new(#f57f17, 0) :
         (passMinN and pf >= 1.15) ? color.new(#e65100, 0) : color.new(#b71c1c, 0)
    table.cell(verifTbl, 0, 10, "Go / No-Go Verdict", bgcolor=color.new(#1c252c, 0), text_color=color.white, text_size=size.tiny, text_halign=text.align_left)
    table.cell(verifTbl, 1, 10, goText, bgcolor=goBg, text_color=color.white, text_size=size.tiny)


// ═══════════════════════════════════════════════════════════════════
//  ⑯ NATIVE PINE v6 STRATEGY EXECUTION (5 Lots = 3 Lot T1 + 2 Lot T2)
//     • Unified Cost Model: `slippage = 40` ticks (40 * 0.05 = 2.00
//       Nifty points per side = 4.00 Nifty points round-trip per unit,
//       independent of `syminfo.pointvalue`, matching `costPtsInput=4.0`!)
//     • Places `strategy.exit()` on the same bar as `strategy.entry()`
//       so Bar 1 is protected from tick 1, and closes at next open on
//       `effMaxHold` Time-Stop (matching the Ledger's `trTimeStopPend`!)
// ═══════════════════════════════════════════════════════════════════
var int   stBarsInTrade = 0
var float stRiskPts     = na
var float stT1Pts       = na
var float stT2Pts       = na
var bool  stReachedT1   = false

bool stFlat = strategy.position_size == 0

if not stFlat
    stBarsInTrade += 1
    float avgFill = strategy.position_avg_price
    if strategy.position_size > 0
        if high >= avgFill + stT1Pts
            stReachedT1 := true
        float runnerStopL = stReachedT1 ? avgFill : (avgFill - stRiskPts)
        strategy.exit("L_T1_60%", from_entry="LONG", qty=3, limit=avgFill + stT1Pts, stop=avgFill - stRiskPts, comment_profit="T1_60%", comment_loss="SL_INIT")
        strategy.exit("L_T2_40%", from_entry="LONG", qty=2, limit=avgFill + stT2Pts, stop=runnerStopL, comment_profit="T2_40%", comment_loss=stReachedT1 ? "BE_STOP" : "SL_INIT")
        if stBarsInTrade >= effMaxHold or not inAuditWindow
            strategy.close("LONG", comment="TIME_STOP")
    else if strategy.position_size < 0
        if low <= avgFill - stT1Pts
            stReachedT1 := true
        float runnerStopS = stReachedT1 ? avgFill : (avgFill + stRiskPts)
        strategy.exit("S_T1_60%", from_entry="SHORT", qty=3, limit=avgFill - stT1Pts, stop=avgFill + stRiskPts, comment_profit="T1_60%", comment_loss="SL_INIT")
        strategy.exit("S_T2_40%", from_entry="SHORT", qty=2, limit=avgFill - stT2Pts, stop=runnerStopS, comment_profit="T2_40%", comment_loss=stReachedT1 ? "BE_STOP" : "SL_INIT")
        if stBarsInTrade >= effMaxHold or not inAuditWindow
            strategy.close("SHORT", comment="TIME_STOP")
else
    stBarsInTrade := 0
    stReachedT1   := false

// Queue entry AND first-bar protective exits simultaneously on confirmed signal bar close
if stFlat and barstate.isconfirmed and not na(atr14)
    if auditLongSig
        float rawSL   = (includeSwings and swLongGated) ? swBotSL : bearTrapSL
        [rPts, t1P, t2P, effSL_stL, t1Price_stL, t2Price_stL] = f_calcRiskAndTargets(true, rawSL)
        stRiskPts    := rPts
        stT1Pts      := t1P
        stT2Pts      := t2P
        int slTicks   = int(math.round(stRiskPts / syminfo.mintick))
        int t1Ticks   = int(math.round(stT1Pts   / syminfo.mintick))
        int t2Ticks   = int(math.round(stT2Pts   / syminfo.mintick))
        strategy.entry("LONG", strategy.long, qty=5, comment="LONG_5L")
        strategy.exit("L_T1_60%", from_entry="LONG", qty=3, profit=t1Ticks, loss=slTicks, comment_profit="T1_60%", comment_loss="SL_INIT")
        strategy.exit("L_T2_40%", from_entry="LONG", qty=2, profit=t2Ticks, loss=slTicks, comment_profit="T2_40%", comment_loss="SL_INIT")
    else if auditShortSig
        float rawSL   = (includeSwings and swShortGated) ? swTopSL : bullTrapSL
        [rPts, t1P, t2P, effSL_stS, t1Price_stS, t2Price_stS] = f_calcRiskAndTargets(false, rawSL)
        stRiskPts    := rPts
        stT1Pts      := t1P
        stT2Pts      := t2P
        int slTicks   = int(math.round(stRiskPts / syminfo.mintick))
        int t1Ticks   = int(math.round(stT1Pts   / syminfo.mintick))
        int t2Ticks   = int(math.round(stT2Pts   / syminfo.mintick))
        strategy.entry("SHORT", strategy.short, qty=5, comment="SHORT_5L")
        strategy.exit("S_T1_60%", from_entry="SHORT", qty=3, profit=t1Ticks, loss=slTicks, comment_profit="T1_60%", comment_loss="SL_INIT")
        strategy.exit("S_T2_40%", from_entry="SHORT", qty=2, profit=t2Ticks, loss=slTicks, comment_profit="T2_40%", comment_loss="SL_INIT")
